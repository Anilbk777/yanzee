enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum ProductAudience {
  MEN
  WOMEN
  UNISEX
  BOY
  GIRL
  KIDS_UNISEX
}

enum ProductChannel {
  ALL
  WEBSITE
  POS
}

model Product {
  id      String @id @default(uuid())
  storeId String @map("store_id")
  store   Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  name               String
  slug               String // product page URL: /products/nike-air-max
  productDescription String?         @map("product_description") @db.Text
  longDescription    String?         @map("long_description") @db.Text
  audience           ProductAudience @default(UNISEX)
  status             ProductStatus   @default(DRAFT)
  channel            ProductChannel  @default(ALL)
  isAvailable        Boolean         @default(true) @map("is_available")
  hasVariants        Boolean         @default(false) @map("has_variants")

  // Many-to-Many relationship with Category
  categories Category[]

  // One-to-Many relationship with Brand (Optional)
  brandId String? @map("brand_id")
  brand   Brand?  @relation(fields: [brandId], references: [id], onDelete: SetNull)

  // Pricing & Inventory fields
  crossedPrice Decimal? @map("crossed_price") @db.Decimal(12, 2)
  sellingPrice Decimal? @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  quantity     Int?
  weight       Decimal? @db.Decimal(8, 3) // Weight in kg
  sku          String?
  hsCode       String?  @map("hs_code")
  altBarcode   String?  @map("alt_barcode")

  // Media & Metadata
  imageUrls   String[]  @default([]) @map("image_urls")
  tags        String[]  @default([])
  releaseDate DateTime? @map("release_date")

  // SEO Fields
  seoTitle       String? @map("seo_title")
  seoDescription String? @map("seo_description") @db.Text
  seoImage       String? @map("seo_image")

  // Ratings & Self-referencing relationship for Similar Products
  ratingAvg       Decimal   @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount     Int       @default(0) @map("rating_count")
  similarProducts Product[] @relation("SimilarProducts")
  similarTo       Product[] @relation("SimilarProducts")

  variants   ProductVariant[]
  orderItems OrderItem[]
  reviews    Review[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([id, storeId])
  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId, status, createdAt])
  @@index([storeId, brandId, status])
  @@index([storeId, audience, status])
  @@map("products")
}

model ProductVariant {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  storeId      String   @map("store_id")
  product      Product  @relation(fields: [productId, storeId], references: [id, storeId], onDelete: Cascade)
  name         String   @map("name") // e.g., "Red / XL" or "Size 42"
  size         String?
  sku          String?
  colorCodes   String[] @default([]) @map("color_codes") // Array supporting 1 to 2 HEX/CSS color codes
  crossedPrice Decimal? @map("crossed_price") @db.Decimal(12, 2)
  sellingPrice Decimal  @map("selling_price") @db.Decimal(12, 2)
  costPrice    Decimal? @map("cost_price") @db.Decimal(12, 2)
  quantity     Int      @default(0)
  weight       Decimal? @db.Decimal(8, 3)
  hsCode       String?  @map("hs_code")
  altBarcode   String?  @map("alt_barcode")

  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([storeId, sku])
  @@index([productId])
  @@map("product_variants")
}
