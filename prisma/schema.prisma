// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SHOP_OWNER
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id         String   @id @default(uuid())
  email      String   @unique
  password   String
  phone      String
  fullName   String
  gender     Gender   @default(MALE)
  role       UserRole @default(CUSTOMER)
  country    String?
  province   String?
  district   String?
  city       String?
  address    String?
  profileImg String?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  refreshTokens RefreshToken[]
  shop          Shop?
  orders        Order[]
  checkouts     Checkout[]
  cart          Cart?

  @@map("users")
}

// Refresh tokens are stored (hashed) so they can be revoked server-side.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("refresh_tokens")
}

model Shop {
  id      String @id @default(uuid())
  ownerId String @unique @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name         String
  image        String?
  description  String?
  contactEmail String
  contactPhone String?
  address      String?
  returnPolicy String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  products  Product[]
  orders    Order[]

  @@map("shops")
}

enum ProductCategory {
  FASHION
  SPORTS
  KIDS
  BEAUTY
  OUTLET
  PREMIUM
  HOME_DECOR
}

enum ProductStatus {
  ACTIVE
  DRAFT
  OUT_OF_STOCK
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
  FREE_SIZE // for items with no size (bags, home decor, beauty...)
}

// The order STATE. (accept / decline / ready / dispatch / deliver are the
// ACTIONS a shop owner clicks - each action moves the order to a new state.)
enum OrderStatus {
  PENDING // customer placed it, waiting for shop        -> "New" tab
  ACCEPTED // shop clicked Accept                          -> "Processing" tab
  DECLINED // shop clicked Decline (final)
  READY // shop clicked Mark as Ready                      -> "Ready" tab
  DISPATCHED // shop clicked Dispatch                     -> "On the way" tab
  DELIVERED // shop clicked Mark Delivered (final)
  CANCELLED // customer cancelled before acceptance (final)
}

enum PaymentMethod {
  COD
  ESEWA
  KHALTI
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Product {
  id     String @id @default(uuid())
  shopId String @map("shop_id")
  shop   Shop   @relation(fields: [shopId], references: [id], onDelete: Cascade)

  name        String
  description String?         @db.Text
  category    ProductCategory
  status      ProductStatus   @default(DRAFT)

  price         Decimal  @db.Decimal(12, 2) // normal price (NPR)
  discountPrice Decimal? @db.Decimal(12, 2) // optional sale price

  image   String? // cover image URL
  gallery String[] @default([]) // extra image URLs

  variants   ProductVariant[]
  orderItems OrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // [shopId, createdAt] also serves plain shopId lookups, so the single-column
  // index is dropped. [shopId, status] backs the dashboard status tabs.
  @@index([shopId, createdAt])
  @@index([shopId, status])
  @@index([category, status])
  @@map("products")
}

// Stock lives HERE, because M can be sold out while L is still available.
// Total product stock = sum of variant stocks.
model ProductVariant {
  id        String  @id @default(uuid())
  productId String  @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  Size
  stock Int     @default(0)
  sku   String?

  orderItems OrderItem[]
  cartItems  CartItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, size]) // one row per size per product
  // Scoped per product: SKUs are only unique within a product, not globally.
  // Postgres treats NULLs as distinct, so products without a SKU never clash.
  @@unique([productId, sku])
  @@index([productId])
  @@map("product_variants")
}

// ---------- 4. Orders -------------------------------------------------------
// ONE ORDER = ONE SHOP.
// If a customer's cart has items from 3 shops, checkout creates 3 orders that
// share the same `checkoutId`. That way each shop sees, accepts and ships
// only its own order.
model Order {
  id          String   @id @default(uuid())
  orderNumber String   @unique
  checkoutId  String
  checkout    Checkout @relation(fields: [checkoutId], references: [id])

  customerId String
  customer   User   @relation(fields: [customerId], references: [id])
  shopId     String
  shop       Shop   @relation(fields: [shopId], references: [id])

  status        OrderStatus @default(PENDING)
  declineReason String?

  subtotal    Decimal @db.Decimal(12, 2)
  shippingFee Decimal @default(0) @db.Decimal(12, 2)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Delivery address SNAPSHOT (copied from user at order time, so later
  // profile edits do not change old orders)
  recipientName  String
  recipientPhone String
  province       String?
  district       String?
  city           String?
  address        String
  customerNote   String?

  // Delivery tracking
  courierName    String?
  trackingNumber String?

  // Timestamps for each step (for the tracking timeline)
  acceptedAt   DateTime?
  readyAt      DateTime?
  dispatchedAt DateTime?
  deliveredAt  DateTime?

  items   OrderItem[]
  history OrderStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([shopId, status]) // shop dashboard tabs
  @@index([customerId, createdAt]) // "My orders" page
  @@index([checkoutId])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Links stay optional so deleting a product never breaks old orders
  productId String?
  product   Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  // SNAPSHOT of what was bought (price/name may change later)
  productName String
  image       String?
  size        Size
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(12, 2)

  @@index([orderId])
  @@map("order_items")
}

// Every status change is saved -> gives the customer a tracking timeline
// ("Order placed > Accepted > Ready > On the way > Delivered")
model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  changedBy String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model Checkout {
  id            String        @id @default(uuid())
  customerId    String
  customer      User          @relation(fields: [customerId], references: [id])
  totalAmount   Decimal       @db.Decimal(12, 2) // what the customer pays in total
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  fromCart Boolean @default(true) 

  orders   Order[]
  payments Payment[]

  createdAt DateTime @default(now())

  @@map("checkouts")
}

// One row per payment attempt (a customer may retry a failed eSewa payment)
model Payment {
  id              String        @id @default(uuid())
  checkoutId      String
  checkout        Checkout      @relation(fields: [checkoutId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  gatewayRef      String?       @unique // Khalti pidx / eSewa transaction_uuid
  transactionId   String? // final ID from the gateway
  gatewayResponse Json?         @db.Json // raw response, for disputes
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([checkoutId])
  @@map("payments")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("carts")
}

model CartItem {
  id         String         @id @default(uuid())
  cartId     String
  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity   Int            @default(1)
  isSelected Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([cartId, variantId]) // same size added twice = quantity + 1, not a new row
  @@index([cartId])
  @@map("cart_items")
}
